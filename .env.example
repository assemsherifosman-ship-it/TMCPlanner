# TMC Pre-Task Planning Safety agent (Copilot Studio) connection.
# Copy to .env.local (local dev) or add as Environment Variables in Vercel/Azure.
# Set ONE of the two options below.

# Option A — agent with "No authentication":
# Copilot Studio > your agent > Channels > Mobile app > Token Endpoint, e.g.
# https://<env>.environment.api.powerplatform.com/copilotstudio/agenticruntime/botsbyschema/<schema>/directline/token?api-version=2022-03-01-preview
# (older agents use /powervirtualagents/botsbyschema/... instead)
COPILOT_TOKEN_ENDPOINT=

# Option B — agent using web channel security:
# Copilot Studio > your agent > Settings > Security > Web channel security > Secret 1
DIRECTLINE_SECRET=

# Optional: override the Direct Line base URL (regional agents), e.g.
# https://europe.directline.botframework.com/v3/directline
DIRECTLINE_DOMAIN=
